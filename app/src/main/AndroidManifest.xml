<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth Permissions for OBD-II Adapter -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Raise / lower the docked Google Maps window relative to the dashboard (normal permission) -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- Permission to bind real app widgets -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />

    <!-- Location Permission for Maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Agenda and quick-dial widgets (asked for at runtime, only when those tiles are added) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Asking the AI mechanic a question out loud (Fault codes detail sheet) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Internet for Maps and Media Streaming -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone link: finds the phone's hotspot gateway and redials when Wi-Fi changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Second screen (DisplayLink): keeps Wi-Fi out of power saving while
         streaming to the display, so frames aren't held back. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The Wi-Fi switch tile (RadioSwitches.kt); Android 10 also wants the shell for it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Do Not Disturb from the Quick switches tile, once the driver gives the access (QuickSwitches.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Joining and leaving Wi-Fi networks and connecting Bluetooth devices from their tiles
         (NetworkLists.kt): system permissions, only held where PMPatch3 grants them. -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" tools:ignore="ProtectedPermissions" />
    <!-- The screen light tile writes the brightness itself when allowed (else through the shell). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- The MapLibre navigation library posts its own guidance notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 9 only: "Save the log on the unit" writes into Download itself (DebugLog.saveOnUnit). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- In-app updater: download and install new APKs from GitHub Releases -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Floating split-swap button drawn over other apps. Auto-granted for the
         privileged /system/priv-app install; touchable, unlike an accessibility
         overlay which some ROMs render as pass-through only. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- At boot, firmwares that start their own launcher are beaten to the screen (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Google Maps inside a tile (EmbeddedApp.kt): open it on our own display
         and pass it the tile's touches. Kept for the firmware's apps, so only
         granted where PMPatch in Magisk makes every signature check pass. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" tools:ignore="ProtectedPermissions" />

    <!-- The car app's switches in the global settings (RomPopups.writeGlobals)
         without root or the unit's ADB: granted once from a PC with
         "adb shell pm grant com.openauto.dash android.permission.WRITE_SECURE_SETTINGS". -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- The car app's log, where it writes the steering angle once its own guide lines are hidden (ReverseView). Granted through the root shell. -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <!-- The reversing camera's picture shown by Dashwheel itself (ReverseCamera, experimental). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Hardware Requirements -->
    <!-- OBD adapters are classic Bluetooth (or USB, or relayed by the phone): nothing needs BLE,
         and a unit that doesn't declare it must still find the app on Google Play. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.audio.output" android:required="true" />
    <!-- OBD adapters on a USB cable (UsbObd.kt); Bluetooth ones still work without it. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Package visibility (Android 11+): lets the app drawer enumerate every
         launchable app and resolve their launch intents. -->
    <queries>
        <!-- The QF firmware's own apps (ROCO K706): its Bluetooth phone and car apps (calls and pop-ups, see
             HeadUnitPhone / RomPopups), its camera app, its framework (the volume bar), its radio, the TPMS app
             and the CarPlay app; UnitPlatform checks which are there. -->
        <package android:name="com.qf.bluetooth" />
        <package android:name="com.qf.vehicle" />
        <package android:name="com.qf.backcar" />
        <package android:name="com.qf.framework" />
        <package android:name="com.android.fmradio.ext" />
        <package android:name="com.syt.tmps" />
        <package android:name="com.zjinnova.zlink" />
        <!-- The FYT firmware's own apps (Joying, Atoto, Mekede...): its main server, whose toolkit service
             Dashwheel binds for the car's data, the keys and the phone (unit/fyt/FytToolkit), its CAN app,
             its CarPlay app and its launcher. -->
        <package android:name="com.syu.ms" />
        <package android:name="com.syu.canbus" />
        <package android:name="com.syu.carlink" />
        <package android:name="com.syu.bt" />
        <package android:name="com.syu.radio" />
        <package android:name="com.syu.air" />
        <package android:name="com.android.launcher4" />
        <package android:name="com.android.launcher6" />
        <intent>
            <action android:name="com.syu.ms.toolkit" />
        </intent>
        <!-- The Microntek (MTCD / MTCE / MTCH) firmware's sleep whitelist app, offered from the Head unit card. -->
        <package android:name="com.microntek.bootcontrol" />
        <!-- Topway TS and Reglink units' own apps, which name their family to UnitPlatform. -->
        <package android:name="com.tw.car" />
        <package android:name="com.tw.carchoose" />
        <package android:name="com.tw.carapps" />
        <package android:name="com.tw.ac2" />
        <package android:name="com.tv.carinfoservice" />
        <package android:name="com.reglink.services" />
        <package android:name="com.reglink.launcher4" />
        <package android:name="com.baony.avm360" />
        <!-- The XYAuto ("9320") units' CAN stack: its host app and the per-brand decoder
             plugin, which together publish the car's data as plain broadcasts. -->
        <package android:name="com.kyhero.car.myhost" />
        <package android:name="com.kyhero.car.myplugin.canbus" />
        <!-- Deep OBD, which can report the car's readings in place of an adapter (DeepObdSource). -->
        <package android:name="de.holeschak.bmw_deep_obd" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Dictating a reply to a phone message, when the head unit has a recogniser. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".DashApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAutoDash">

        <!-- MainActivity: standard launcher entry + acts as an Android Home app.
             Orientation is left responsive so the 50/50 layout adapts to
             landscape head units and portrait phone mounts. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">

            <!-- Appears in the app drawer / launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allows selection as the device Home launcher (car head units). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- No activity for "USB device attached": Android made Dashwheel the
             default for the unit's TPMS receiver (same chip as OBD cables), and
             the TPMS app lost it at each reconnection. A USB OBD cable is let
             in when the driver picks it (UsbObd.allow). -->

        <!-- The Play edition's disclosure dialog before the accessibility or
             notification access page (AccessDisclosure.kt). -->
        <activity
            android:name=".AccessDisclosureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.OpenAutoDash.Transparent" />

        <!-- Reads active media sessions (title/artist/playback) from other apps.
             Requires the user to grant Notification access in system settings. -->
        <service
            android:name=".MediaNotificationListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Triggers the system's built-in split-screen (the same path as the
             recents long-press gesture) via GLOBAL_ACTION_TOGGLE_SPLIT_SCREEN.
             Enabled once by the user under Settings → Accessibility. -->
        <service
            android:name=".SplitAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/split_accessibility_config" />
        </service>

        <!-- FileProvider used to share the downloaded update APK with the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- MediaTek (Reglink) and Autochips units wake with these instead of a boot (AccBroadcasts.BOOT_LIKE). -->
                <action android:name="com.mediatek.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.mediatek.intent.action.BOOT_IPO" />
                <action android:name="autochips.intent.action.QB_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
